      *****************************************************************
      *                      ENVIRONMENT DIVISION                     *
      *****************************************************************
       ENVIRONMENT DIVISION.

       CONFIGURATION SECTION.
       SPECIAL-NAMES.
           DECIMAL-POINT IS COMMA.

      *****************************************************************
      *                         DATA DIVISION                         *
      *****************************************************************
       DATA DIVISION.

       WORKING-STORAGE SECTION.

      *--- ZONA CICS --------------------------------------------------
       COPY DFHAID.
       COPY DFHBMSCA.
       COPY HOLEMP.
      *--- ZONA CICS FIN ----------------------------------------------

      *--- ZONA WORKING -----------------------------------------------
       01  FILLER                          PIC X(19)
           VALUE '***START-WORKING***'.

       COPY HOLWS.

       01  WI-INDICADORES.
           03 WI-ENVIO-MAPA                PIC 9(01).
              88 ENVIO-ERASE                          VALUE 1.
              88 ENVIO-DATAONLY                       VALUE 2.

       01  WL-LITERALES.
           03 WL-FIN-SESION                PIC X(36)  VALUE
              'La transaccion HOLE ha finalizado...'.

       01  FILLER                          PIC X(17)
           VALUE '***END-WORKING***'.
      *--- ZONA WORKING FIN -------------------------------------------

       LINKAGE SECTION.

       01  DFHCOMMAREA                     PIC X(2048).

      *****************************************************************
      *                       PROCEDURE DIVISION                      *
      *****************************************************************
       PROCEDURE DIVISION.

      *----------------------------------------------------------------
      *    PROCESO PRINCIPAL
      *----------------------------------------------------------------
       0000-PRINCIPAL.
           EXEC SQL
                INCLUDE PCONFIG
           END-EXEC

           MOVE CT-TRN-ERROR               TO WA-TRANS

           IF  EIBCALEN > ZEROS
               MOVE DFHCOMMAREA            TO CA-COMMAREA-HOL
           END-IF

           EVALUATE TRUE
      *       No hay Commarea
      *       Se inicializa la Commarea y envia el mapa limpio
      *       Situacion anormal, no se debe arrancar HOLE desde CICS
              WHEN EIBCALEN = ZEROS
                   MOVE LOW-VALUES         TO HOLEMPO
                   INITIALIZE              CA-COMMAREA-HOL
                   SET ENVIO-ERASE         TO TRUE
                   MOVE 'La transaccion no es arrancable desde CICS'
                                           TO MSGO
                   PERFORM 9000-ENVIA-MAPA

      *       Hay Commarea
      *       El programa ha sido arrancado por XCTL desde otro
      *       programa, la transaccion actual NO sera la DE este
      *       programa en el primer ciclo de ejecucion
              WHEN EIBCALEN > ZEROS
              AND  EIBTRNID NOT = WA-TRANS
                   MOVE LOW-VALUES         TO HOLEMPO
                   SET ENVIO-ERASE         TO TRUE
                   PERFORM 1000-CARGA-DATOS
                   MOVE 'Este es el error detectado. Sigue con F3'
                                           TO MSGO
                   PERFORM 9000-ENVIA-MAPA

      *       Borrado de la pantalla y envio de mensaje de fin de
      *       sesion al usuario. Se devuelve el control a CICS
              WHEN EIBAID = DFHCLEAR
                   MOVE LOW-VALUES         TO HOLEMPO
                   PERFORM 9000-ENVIA-MENSAJE
                   PERFORM 9000-RETORNO-CICS

      *       Borrado de la pantalla y envio de mensaje de fin de
      *       sesion al usuario. Se devuelve el control a CICS
              WHEN EIBAID = DFHPF3
              AND  CA-TRANS-RETORNO = SPACES
                   MOVE LOW-VALUES         TO HOLEMPO
                   PERFORM 9000-ENVIA-MENSAJE
                   PERFORM 9000-RETORNO-CICS

              WHEN EIBAID = DFHPF3
              AND  CA-TRANS-RETORNO NOT = SPACES
                   MOVE CA-PROG-RETORNO    TO CA-XCTL
                   PERFORM 9000-XCTL-PROGRAMA

              WHEN EIBAID = DFHENTER
                   SET ENVIO-DATAONLY      TO TRUE
                   MOVE 'Por favor, pulsa F3 para salir' TO MSGO
                   PERFORM 9000-ENVIA-MAPA

              WHEN OTHER
                   SET ENVIO-DATAONLY      TO TRUE
                   MOVE 'Tecla no valida'  TO MSGO
                   PERFORM 9000-ENVIA-MAPA
           END-EVALUATE

           PERFORM 9000-RETORNO-TRANS
           .
       0000-PRINCIPAL-EXIT.
           EXIT.

      *----------------------------------------------------------------
      *    Carga los datos de Commarea en pantalla
      *----------------------------------------------------------------
       1000-CARGA-DATOS.
           MOVE CA-E-TRANS                 TO TRANO
           MOVE CA-E-PROG                  TO PROGO
           MOVE CA-E-PARRAFO               TO PARRO
           MOVE CA-E-ACCION                TO ACCO
           MOVE CA-E-CODIGO                TO CODO
           MOVE CA-E-MENSAJE               TO MSJO
           .
       1000-CARGA-DATOS-EXIT.
           EXIT.

      *----------------------------------------------------------------
      *    Envia el mapa al terminal sergun modo del switch
      *----------------------------------------------------------------
       9000-ENVIA-MAPA.
           EVALUATE TRUE
      *       Envio deL mapa limpio
              WHEN ENVIO-ERASE
                   EXEC CICS
                        SEND
                        MAP    ('HOLEMP')
                        MAPSET ('HOLEMP')
                        FROM   (HOLEMPO)
                        ERASE
                   END-EXEC

      *       Envio del mapa datos unicamente
              WHEN ENVIO-DATAONLY
                   EXEC CICS
                        SEND
                        MAP      ('HOLEMP')
                        MAPSET   ('HOLEMP')
                        FROM     (HOLEMPO)
                        DATAONLY
                   END-EXEC
           END-EVALUATE
           .
       9000-ENVIA-MAPA-EXIT.
           EXIT.

      *----------------------------------------------------------------
      *    Envia un mensaje al terminal del usuario (fin sesion)
      *----------------------------------------------------------------
       9000-XCTL-PROGRAMA.
           EXEC CICS
                SET TERMINAL(EIBTRMID)
                UCTRAN
           END-EXEC

           EXEC CICS
                XCTL
                PROGRAM  (CA-XCTL)
                COMMAREA (CA-COMMAREA-HOL)
                LENGTH   (LENGTH OF CA-COMMAREA-HOL)
                RESP     (WA-RESP1-CICS)
                RESP2    (WA-RESP2-CICS)
           END-EXEC
           .
       9000-XCTL-PROGRAMA-EXIT.
           EXIT.

      *----------------------------------------------------------------
      *    Envia un mensaje al terminal del usuario (fin sesion)
      *----------------------------------------------------------------
       9000-ENVIA-MENSAJE.
           EXEC CICS
                SEND
                TEXT
                FROM   (WL-FIN-SESION)
                ERASE
                FREEKB
           END-EXEC
           .
       9000-ENVIA-MENSAJE-EXIT.
           EXIT.

      *----------------------------------------------------------------
      *    Devuelve el control a CICS - Salida total
      *----------------------------------------------------------------
       9000-RETORNO-CICS.
           EXEC CICS
                SET TERMINAL(EIBTRMID)
                UCTRAN
           END-EXEC

           EXEC CICS
                RETURN
           END-EXEC
           .
       9000-RETORNO-CICS-EXIT.
           EXIT.

      *----------------------------------------------------------------
      *    Devuelve el control a una transaccion
      *----------------------------------------------------------------
       9000-RETORNO-TRANS.
           EXEC CICS
                RETURN
                TRANSID  (WA-TRANS)
                COMMAREA (CA-COMMAREA-HOL)
                LENGTH   (LENGTH OF CA-COMMAREA-HOL)
           END-EXEC
           .
       9000-RETORNO-TRANS-EXIT.
           EXIT.