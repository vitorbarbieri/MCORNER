-- ====================================================================
-- SCRIPT   : CREACION DE TABLESPACE EN DB2 Z/OS
-- OBJETIVO : DEFINIR UN ESPACIO DE TABLAS FISICO/LOGICO DENTRO DE UNA
--            BASE DE DATOS, CONFIGURANDO ASIGNACION DE ESPACIO EN
--            DISCO, RENDIMIENTO Y PARAMETROS DE BLOQUEO
-- VERSION  : 1.0
-- ====================================================================

-- DROP TABLESPACE MCORNDB.CLIENTS;

-- COMMIT;

CREATE TABLESPACE CLIENTS
    IN MCORNDB
    USING STOGROUP MCORNSG
    PRIQTY 250
    SECQTY 100
    ERASE NO
    FREEPAGE 10
    PCTFREE 10
    BUFFERPOOL BP1
    COMPRESS NO
    LOCKSIZE ANY
    LOCKMAX SYSTEM
    CLOSE YES;

COMMIT;