-- SCRIPT   : CREACION DE TABLA E INDICE UNICO EN DB2 Z/OS
-- OBJETIVO : DEFINIR LA ESTRUCTURA RELACIONAL DE LA TABLA DE CLIENTES
--            Y SU INDICE PRIMARIO AGRUPADO (CLUSTERED INDEX) PARA
--            GARANTIZAR INTEGRIDAD Y RENDIMIENTO DE ACCESO
-- VERSION  : 1.0
-- ====================================================================

-- DROP TABLE MCORNER.CLIENTES;

-- COMMIT;

CREATE TABLE MCORNER.CLIENTES (
    DNI         CHAR(9)    NOT NULL,
    NOMBRE      CHAR(20)   NOT NULL,
    APELLIDOS   CHAR(20)   NOT NULL,
    DIRECCION   CHAR(35)   NOT NULL,

    PRIMARY KEY (
        DNI
    )
) IN MCORNDB.CLIENTS;

CREATE UNIQUE INDEX CLIENTES_IPK ON MCORNER.CLIENTES (
    DNI
) CLUSTER CLOSE NO
  USING STOGROUP MCORNSG
  BUFFERPOOL BP1;

COMMIT;