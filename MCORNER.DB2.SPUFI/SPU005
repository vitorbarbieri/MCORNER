-- ====================================================================
-- SCRIPT   : CREACION DE TABLESPACE EN DB2 Z/OS
-- OBJETIVO : DEFINIR EL ESPACIO DE TABLAS GENERICO (TABLASTS) DENTRO
--            DE LA BASE DE DATOS MCORNDB, CONFIGURANDO PARAMETROS DE
--            ESPACIO, RENDIMIENTO Y CONTROL DE BLOQUEOS
-- VERSION  : 1.0
-- ====================================================================

-- DROP TABLESPACE MCORNDB.TABLASTS;

-- COMMIT;

CREATE TABLESPACE TABLASTS
    IN MCORNDB
    USING STOGROUP MCORNSG
    PRIQTY 250
    SECQTY 100
    ERASE NO
    FREEPAGE 10
    PCTFREE 10
    BUFFERPOOL BP1
    COMPRESS NO
    LOCKSIZE ANY
    LOCKMAX SYSTEM
    CLOSE YES;

COMMIT;