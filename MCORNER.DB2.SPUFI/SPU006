-- ====================================================================
-- SCRIPT   : CREACION DE TABLA DE PARAMETROS/TABLAS AUXILIARES
-- OBJETIVO : DEFINIR UNA ESTRUCTURA GENERICA BASADA EN CLAVE-VALOR
--            PARA ALMACENAR CONFIGURACIONES O TABLAS AUXILIARES,
--            OPTIMIZADA MEDIANTE UN INDICE UNICO AGRUPADO COMPUESTO
-- VERSION  : 1.0
-- ====================================================================

-- DROP TABLE MCORNER.TABLAS;

-- COMMIT;

CREATE TABLE MCORNER.TABLAS (
    TABLA    CHAR(8)    NOT NULL,
    CLAVE1   CHAR(8)    NOT NULL,
    CLAVE2   CHAR(8),
    CLAVE3   CHAR(8),
    VALOR    CHAR(64)   NOT NULL
) IN MCORNDB.TABLASTS;

CREATE UNIQUE INDEX TABLAS_IPK ON MCORNER.TABLAS (
    TABLA,
    CLAVE1,
    CLAVE2,
    CLAVE3
) CLUSTER CLOSE NO
  USING STOGROUP MCORNSG
  BUFFERPOOL BP1;

COMMIT;