-- ====================================================================
-- SCRIPT   : CREACION DE TABLESPACE EN DB2 Z/OS
-- OBJETIVO : DEFINIR EL ESPACIO DE TABLAS (AYUDASTS) DENTRO DE LA
--            BASE DE DATOS MCORNDB, CONFIGURANDO PARAMETROS OPTIMOS
--            DE ASIGNACION DE ESPACIO, RENDIMIENTO Y CONTROL
-- VERSION  : 1.0
-- ====================================================================

-- DROP TABLESPACE MCORNDB.AYUDASTS;

-- COMMIT;

CREATE TABLESPACE AYUDASTS
    IN MCORNDB
    USING STOGROUP MCORNSG
    PRIQTY 250
    SECQTY 100
    ERASE NO
    FREEPAGE 10
    PCTFREE 10
    BUFFERPOOL BP1
    COMPRESS NO
    LOCKSIZE ANY
    LOCKMAX SYSTEM
    CLOSE YES;

COMMIT;